{
  "name": "opal-mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for Google Opal - Control AI mini-apps from your AI assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "opal-mcp-server": "dist/index.js",
    "opal-mcp-auth": "dist/auth/login.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "auth": "tsx src/auth/login.ts",
    "postinstall": "npx playwright install chromium --with-deps 2>/dev/null || npx playwright install chromium || echo 'Note: Run npx playwright install chromium manually if needed'"
  },
  "keywords": [
    "mcp",
    "google-opal",
    "opal",
    "ai",
    "model-context-protocol",
    "playwright",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/epicperuofficial/opal-mcp-server.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "playwright": "^1.52.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0"
  }
}
